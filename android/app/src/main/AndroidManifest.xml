<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tiles for the trip map (osmdroid fetches them itself). Nothing in the app
         reaches a unit over the network any more, so the three Wi-Fi / connectivity
         permissions went out with the HTTP transport: they were read by the discovery
         sweep (`Nsd`, the subnet scan, `DeviceVerifier`) and by the reconnect hints
         that explained why a LAN could not be seen - none of which exist now. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth LE. The firmware V2.0.0 units have no Wi-Fi at all: the phone is
         their only client, and this radio is the transport for settings, telemetry,
         weather, time and firmware. `neverForLocation` is the assertion Android 12+
         wants - the scan is filtered by our own service UUID and is never used to
         derive a position - so the app does not have to ask for location on 31+.
         On Android 11 and below a BLE scan is a location scan as far as the
         platform is concerned, which is why ACCESS_FINE_LOCATION is capped there. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- A V2 unit has no Wi-Fi at all, so a phone without a BLE radio cannot reach one
         in any way. Still not `required=true`: a phone without Bluetooth can run the
         app's own pages (trips, recording, settings) and that has been the shipped
         behaviour - making the radio mandatory changes who can install the APK, which
         is the maintainer's call, not a side effect of deleting the HTTP client. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Trip recording (see the trip recording plan). A foreground service with
         a permanent notification is the only way Android lets a companion app
         keep polling the car while the phone is doing its own thing; the wake
         lock is what keeps that poll alive when the screen times out, and it is
         held only while a trip is actually open. POST_NOTIFICATIONS is runtime on
         Android 13+: without it the service still runs, the notification is just
         not shown, and the recording switch explains that in the UI. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional: the Settings screen offers a battery-optimisation exemption so
         the OEM doze killer does not end a drive mid-trip. Never requested at
         install time, only offered once in the UI. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Shared storage (shared storage plan §1). Trip CSVs, vehicle card JPEGs and the
         garage file are written to Documents/Dashboard++, a folder the owner can open in a
         file manager and see over USB - which is the whole point, and the only way to get it
         is *All files access*. Scoped storage gives no ordinary permission that reaches a
         folder another app owns, and the media store would put card photos in the camera roll.

         This is a special access, not a runtime permission: no dialog can ask for it, so the
         app ships without it and the Storage card on the settings page jumps to the system
         page that grants it (`storage/AppRoot.kt`). Declaring it grants nothing on its own.

         All files access is on the Play policy list, and this app does not go through Play:
         it is shipped as a sideloaded debug APK by its maintainer to the devices it runs on.
         If that ever changes, this permission and the shared root are the things to revisit -
         not the file layout, which degrades to the app-private folder when the grant is absent.
         `storage/AppRoot.kt` states the same trade from the code side. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 8/9 only. Scoped storage applies to apps running on Android 10 and up, so on
         API 26-28 this ordinary runtime permission is what makes public Documents writable at
         all, and MainActivity asks for it the way it asks for notifications. Capped at 28
         because on a newer device it is answered by All files access instead, and a permission
         nothing reads is still a promise the app's listing makes. API 29 gets neither (see
         AppRoot.isGranted) and keeps the app-private folder. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Package visibility, Android 11+. The editor's TAKE PHOTO button hands an
         IMAGE_CAPTURE intent to whatever camera the device has, and from API 30 an app that
         does not declare the action here cannot see - so cannot resolve, so cannot launch -
         the camera activity at all. The symptom of forgetting this block is a sentence that
         is not true: "no camera is available here" on a phone with two of them. The gallery
         route needs no entry, because the photo picker is chosen by the system rather than
         resolved by us. AppXmlWiringTest asserts this block stays. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".DashboardApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Dashboardpp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboard|keyboardHidden|navigation|density|smallestScreenSize|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask=false: swiping the app away must not end a drive that is
             being logged. The service seals the trip and stops on its own once
             the device has been unreachable past the idle window. -->
        <service
            android:name=".service.TripLogService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!-- Share-sheet access to exported CSV/GPX, read-only and per-URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files_path" />
        </provider>
    </application>
</manifest>
